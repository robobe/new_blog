{
    "folders": [
        {
            "name": "my_app",
            "path": "my_app"
        },
        {
            "name": "logging_lib",
            "path": "logging_lib"
        }
    ],
    "settings": {
        "cmake.sourceDirectory": "${workspaceFolder:my_app}",
        "cmake.buildDirectory": "${workspaceFolder:my_app}/build",
        "cmake.configureSettings": {
            "LOGGING_LIB_SOURCE": "${workspaceFolder:logging_lib}"
        }
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools"
        ]
    }
}
